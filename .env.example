# Placeholder names only. Copy to .env.local (and Netlify env vars) and fill in real values. Never commit real keys.
DATABASE_URL=
ADMIN_PASSWORD=
SESSION_SECRET=
ZAR_PER_USD=18.5
SITE_URL=http://localhost:3000

# Email delivery (optional). Any SMTP provider works; leave empty to only record emails in the admin.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your address, SMTP_PASS=an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "<store name> <SMTP_USER>".
EMAIL_FROM=

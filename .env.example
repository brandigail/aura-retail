# Placeholder names only. Copy to .env.local (and your host's environment variables) and fill in real values.
# Never commit real keys.

# Neon Postgres. DATABASE_URL is the pooled connection the app uses; the unpooled one is used for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Owner login for /admin, and the secret that signs the login cookie (use a long random string).
ADMIN_PASSWORD=
SESSION_SECRET=

# The public address of the shop, used in emails, the sitemap and social previews.
SITE_URL=http://localhost:3000

# Email delivery (optional). Any SMTP provider works; leave empty to only record emails in the admin.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your address, SMTP_PASS=an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "<store name> <SMTP_USER>".
EMAIL_FROM=
